<Application x:Class="DrivingCoach.Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kein StartupUri: das Fenster wird in App.xaml.cs erzeugt, weil erst
         die Kommandozeile entscheidet, ob AMS2 oder der Simulator die Daten
         liefert. -->
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Farbwelt: gedämpfter Hintergrund, damit die Strecke durchscheint,
             und kräftige Akzente, die im Augenwinkel erfassbar sind. -->
        <SolidColorBrush x:Key="PanelBrush" Color="#D8101418" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="MoveModeBorderBrush" Color="#FFFFC43D" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFE8EDF2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF8A9BAE" />
        <SolidColorBrush x:Key="FasterBrush" Color="#FF36C75A" />
        <SolidColorBrush x:Key="SlowerBrush" Color="#FFE83A2F" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFFFC43D" />
        <SolidColorBrush x:Key="OfflineBrush" Color="#FFE83A2F" />

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <!-- Konsolenschrift: bei proportionaler Schrift zappelt die
                 Rundenzeit bei jedem Ziffernwechsel in der Breite. -->
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Drehzahlband: zwei Rechtecke statt der Standardvorlage, die in
             WPF mit Farbverlauf und Animation daherkommt. -->
        <Style x:Key="RpmBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource FasterBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Rectangle Fill="#40000000" RadiusX="2" RadiusY="2" />
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator"
                                       Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left"
                                       RadiusX="2" RadiusY="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
