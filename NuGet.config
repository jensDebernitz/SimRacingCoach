<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear /> ist hier das Wesentliche: Ohne das erbt der Build die Quellen aus
    %AppData%\NuGet\NuGet.Config. Auf einem Firmenrechner steht dort ein
    internes Artifactory, das von außerhalb des Firmennetzes nicht erreichbar
    ist - der Build bricht dann mit "Der Dienstindex konnte nicht geladen
    werden" ab, obwohl alle Pakete öffentlich sind.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
